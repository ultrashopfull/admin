{
  "id": "/admin/",
  "name": "UltraShop · Panel de licencias",
  "short_name": "UltraShop",
  "description": "Panel administrativo de clientes, licencias y cuentas de UltraShop.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "/admin/index.html",
  "scope": "/admin/",
  "display": "standalone",
  "display_override": [
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#15171b",
  "theme_color": "#15171b",
  "categories": [
    "business",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/admin/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/admin/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/admin/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "id": "io.github.ultrashopfull.twa"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}
